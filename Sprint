<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plateforme Stratégique NFC • Pilotage & SAS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @media print {
            body * { visibility: hidden; }
            #printable-area, #printable-area * { visibility: visible; }
            #printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                box-shadow: none !important;
                border: none !important;
                background: white !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .no-print { display: none !important; }
        }
        [contenteditable="true"]:hover {
            outline: 1px dashed #cbd5e1;
            border-radius: 4px;
        }
        [contenteditable="true"]:focus {
            outline: 2px solid #f59e0b;
            background-color: #fffbeb;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- TOP NAVBAR SOMBRE -->
    <header class="bg-slate-900 text-white shadow-xl sticky top-0 z-50 no-print">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <span class="bg-amber-500 text-slate-950 font-black px-2.5 py-1 rounded-lg text-sm">NFC</span>
                    <div>
                        <h1 class="text-sm font-bold leading-tight">Projet E-Réputation B2B • Pilotage Terrain & SAS</h1>
                        <p id="header-associes" class="text-[11px] text-slate-400">Nathan, Charly, Etan • Synchro Cloud Temps Réel 24/7</p>
                    </div>
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="chargerDepuisCloud(true)" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-700 transition cursor-pointer">
                        🔄 Actualiser
                    </button>
                    <div id="sync-badge" class="bg-emerald-950 text-emerald-400 text-[11px] font-bold px-3 py-1 rounded-full border border-emerald-800 flex items-center space-x-1.5">
                        <span id="sync-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="sync-text">Cloud Sync Actif</span>
                    </div>
                </div>
            </div>

            <!-- BARRE D'ONGLETS (4 RUBRIQUES) -->
            <nav class="flex flex-wrap gap-2 pt-1">
                <button onclick="ouvrirOnglet('tab-bp')" id="btn-tab-bp" class="tab-btn bg-amber-500 text-slate-950 font-bold text-xs px-4 py-2 rounded-lg transition cursor-pointer">📊 Business Plan & Ventes</button>
                <button onclick="ouvrirOnglet('tab-journal')" id="btn-tab-journal" class="tab-btn bg-slate-800 text-slate-300 hover:bg-slate-700 font-medium text-xs px-4 py-2 rounded-lg transition cursor-pointer">📝 Journal & Actes SAS</button>
                <button onclick="ouvrirOnglet('tab-crm')" id="btn-tab-crm" class="tab-btn bg-slate-800 text-slate-300 hover:bg-slate-700 font-medium text-xs px-4 py-2 rounded-lg transition cursor-pointer">🎯 CRM & Prospection</button>
                <button onclick="ouvrirOnglet('tab-roi')" id="btn-tab-roi" class="tab-btn bg-slate-800 text-slate-300 hover:bg-slate-700 font-medium text-xs px-4 py-2 rounded-lg transition cursor-pointer">💡 Simulateur ROI Client</button>
            </nav>
        </div>
    </header>

    <!-- CONTENU PRINCIPAL -->
    <main class="max-w-6xl w-full mx-auto px-4 py-6 space-y-6 flex-grow">

        <!-- BANNIÈRE OPÉRATIONNELLE (MASQUÉE SUR LE SIMULATEUR CLIENT) -->
        <div id="top-banner" class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white p-6 rounded-2xl shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4 no-print">
            <div class="space-y-1 max-w-2xl">
                <p id="banner-associes" class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">ASSOCIÉS : NATHAN, CHARLY, ETAN • ART. L. 210-6 & R. 210-5 CODE DE COMMERCE</p>
                <h2 class="text-xl font-extrabold">Pilotage Unifié (CRM ⇄ Business Plan ⇄ Actes SAS)</h2>
                <p class="text-xs text-slate-300">Toute vente passée en « Vendu » dans le CRM met automatiquement à jour le Business Plan, la jauge financière et le document officiel de reprise SAS.</p>
            </div>
            <div class="bg-slate-800/90 border border-slate-700 rounded-xl px-5 py-3 text-center min-w-[180px]">
                <span class="text-[10px] text-slate-400 block">Jauge Financement SAS</span>
                <span id="header-jauge" class="text-lg font-black text-emerald-400">0 € / 500 €</span>
                <span class="text-[9px] text-amber-400 block font-semibold">Bénéfices Nets Gelés</span>
            </div>
        </div>

        <!-- ONGLET 1 : BUSINESS PLAN & SIMULATEUR -->
        <section id="tab-bp" class="tab-content bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6 no-print">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-800">🧮 Business Plan & Jauge de Constitution SAS</h3>
                    <p class="text-xs text-slate-500">Les volumes se calculent automatiquement depuis les ventes validées dans le CRM (ajustables manuellement pour simuler).</p>
                </div>
                <div class="flex items-center space-x-3 text-xs">
                    <div class="flex items-center space-x-1 bg-slate-100 px-2.5 py-1 rounded-lg">
                        <span class="text-slate-600 font-semibold">Cible SAS (€) :</span>
                        <input type="number" id="cfg-cible-sas" value="500" oninput="recalculerEtSauvegarder(false)" class="w-16 bg-white border border-slate-300 rounded px-1.5 py-0.5 font-bold text-slate-900">
                    </div>
                    <div class="flex items-center space-x-1 bg-slate-100 px-2.5 py-1 rounded-lg">
                        <span class="text-slate-600 font-semibold">Charges URSSAF+SumUp (%) :</span>
                        <input type="number" step="0.05" id="cfg-taux-charges" value="14.05" oninput="recalculerEtSauvegarder(false)" class="w-16 bg-white border border-slate-300 rounded px-1.5 py-0.5 font-bold text-slate-900">
                    </div>
                </div>
            </div>

            <!-- 3 CARTES PRODUITS -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="border border-slate-200 rounded-xl p-4 space-y-3 bg-slate-50/50">
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-xs text-slate-800">Carte PVC Solo</span>
                        <span class="bg-slate-200 text-slate-700 text-[10px] font-bold px-2 py-0.5 rounded">Appel</span>
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-500 block mb-1">Volume vendu (CRM : <span id="crm-count-solo" class="font-bold text-slate-700">0</span>)</label>
                        <input type="number" id="vol-solo" min="0" value="0" oninput="recalculerEtSauvegarder(true)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-slate-800">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] text-slate-500 block mb-1">Prix Vente (€)</label>
                            <input type="number" step="0.5" id="prix-solo" min="0" value="25" oninput="recalculerEtSauvegarder(false)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-amber-600">
                        </div>
                        <div>
                            <label class="text-[11px] text-slate-500 block mb-1">Coût Achat (€)</label>
                            <input type="number" step="0.1" id="cogs-solo" min="0" value="2.0" oninput="recalculerEtSauvegarder(false)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-rose-600">
                        </div>
                    </div>
                </div>

                <div class="border-2 border-amber-300 rounded-xl p-4 space-y-3 bg-amber-50/20">
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-xs text-slate-800">Pack Starter (Plaque + Carte)</span>
                        <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded">Best-Seller</span>
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-500 block mb-1">Volume vendu (CRM : <span id="crm-count-starter" class="font-bold text-slate-700">0</span>)</label>
                        <input type="number" id="vol-starter" min="0" value="0" oninput="recalculerEtSauvegarder(true)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-slate-800">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] text-slate-500 block mb-1">Prix Vente (€)</label>
                            <input type="number" step="0.5" id="prix-starter" min="0" value="49" oninput="recalculerEtSauvegarder(false)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-amber-600">
                        </div>
                        <div>
                            <label class="text-[11px] text-slate-500 block mb-1">Coût Achat (€)</label>
                            <input type="number" step="0.1" id="cogs-starter" min="0" value="4.8" oninput="recalculerEtSauvegarder(false)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-rose-600">
                        </div>
                    </div>
                </div>

                <div class="border border-slate-200 rounded-xl p-4 space-y-3 bg-slate-50/50">
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-xs text-slate-800">Pack CHR (3 Plaques + 5 Cartes)</span>
                        <span class="bg-indigo-100 text-indigo-700 text-[10px] font-bold px-2 py-0.5 rounded">Pro</span>
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-500 block mb-1">Volume vendu (CRM : <span id="crm-count-chr" class="font-bold text-slate-700">0</span>)</label>
                        <input type="number" id="vol-chr" min="0" value="0" oninput="recalculerEtSauvegarder(true)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-slate-800">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] text-slate-500 block mb-1">Prix Vente (€)</label>
                            <input type="number" step="0.5" id="prix-chr" min="0" value="139" oninput="recalculerEtSauvegarder(false)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-amber-600">
                        </div>
                        <div>
                            <label class="text-[11px] text-slate-500 block mb-1">Coût Achat (€)</label>
                            <input type="number" step="0.1" id="cogs-chr" min="0" value="12.2" oninput="recalculerEtSauvegarder(false)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs font-bold text-rose-600">
                        </div>
                    </div>
                </div>
            </div>

            <!-- JAUGE PROGRESSION SAS -->
            <div class="bg-slate-900 text-white p-5 rounded-xl space-y-3">
                <div class="flex justify-between items-center">
                    <div>
                        <span class="text-[10px] uppercase font-bold text-emerald-400 block">🎯 FONDS DISPONIBLES POUR CRÉATION SAS</span>
                        <span id="jauge-texte" class="text-xl font-black text-amber-400">0 € / 500 €</span>
                    </div>
                    <span id="jauge-statut" class="bg-emerald-600 text-white text-[10px] font-bold px-3 py-1 rounded-full">⏳ EN COURS (0%)</span>
                </div>
                <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden">
                    <div id="jauge-barre" class="bg-emerald-500 h-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p class="text-[11px] text-slate-400">Couvre l'Annonce Légale (~150 €), le Greffe INPI (~70 €) et le dépôt de capital Qonto (~280 €).</p>
            </div>

            <!-- 4 CARTES KPI -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-slate-900 text-white p-4 rounded-xl">
                    <span class="text-[11px] text-slate-400 block">CA Brut Net TTC</span>
                    <span id="kpi-ca" class="text-xl font-black text-amber-400">0 €</span>
                    <span class="text-[10px] text-slate-400 block mt-1">Encaissé via Mandat EI</span>
                </div>
                <div class="bg-rose-50 border border-rose-100 p-4 rounded-xl">
                    <span class="text-[11px] text-rose-600 font-semibold block">Achats Matériel (COGS)</span>
                    <span id="kpi-cogs" class="text-xl font-black text-rose-700">0 €</span>
                    <span class="text-[10px] text-rose-500 block mt-1">Plaques & Cartes TTC</span>
                </div>
                <div class="bg-amber-50 border border-amber-100 p-4 rounded-xl">
                    <span class="text-[11px] text-amber-700 font-semibold block">URSSAF + Frais TPE</span>
                    <span id="kpi-charges" class="text-xl font-black text-amber-800">0 €</span>
                    <span class="text-[10px] text-amber-600 block mt-1">Provision charges EI</span>
                </div>
                <div class="bg-emerald-700 text-white p-4 rounded-xl">
                    <span class="text-[11px] text-emerald-200 font-semibold block">Bénéfice Net Gelé SAS</span>
                    <span id="kpi-net" class="text-xl font-black text-white">0 €</span>
                    <span class="text-[10px] text-emerald-200 block mt-1">Trésorerie nette SAS</span>
                </div>
            </div>

            <!-- GRAPHIQUES -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                <div class="border border-slate-200 rounded-xl p-4">
                    <h4 class="text-[11px] font-bold uppercase text-slate-500 text-center mb-3">STRUCTURE FINANCIÈRE (€ NET)</h4>
                    <canvas id="chart-structure" height="180"></canvas>
                </div>
                <div class="border border-slate-200 rounded-xl p-4">
                    <h4 class="text-[11px] font-bold uppercase text-slate-500 text-center mb-3">RÉPARTITION CA PAR PRODUIT (€ NET)</h4>
                    <canvas id="chart-produits" height="180"></canvas>
                </div>
            </div>
        </section>

        <!-- ONGLET 2 : JOURNAL DES ACTES -->
        <section id="tab-journal" class="tab-content hidden bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6 no-print">
            <div class="flex flex-wrap justify-between items-center gap-2">
                <div>
                    <h3 class="text-base font-bold text-slate-800">📝 Journal des Actes & Dépenses (Art. R. 210-5)</h3>
                    <p class="text-xs text-slate-500">Toutes les cases du tableau ci-dessous restent modifiables à tout moment en cliquant directement dedans.</p>
                </div>
                <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2 rounded-lg cursor-pointer shadow">
                    🖨️ Imprimer / Exporter en PDF l'Acte Officiel
                </button>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-5 gap-2 text-xs">
                <input type="date" id="acte-date" class="border border-slate-200 rounded-lg p-2">
                <input type="text" id="acte-desc" placeholder="Nature de l'acte (ex: Achat lot 50 plaques NFC, Dépôt INPI...)" class="border border-slate-200 rounded-lg p-2 md:col-span-2">
                <select id="acte-auteur" class="border border-slate-200 rounded-lg p-2"></select>
                <div class="flex gap-2">
                    <input type="number" step="0.01" id="acte-montant" placeholder="Montant TTC €" class="border border-slate-200 rounded-lg p-2 w-full">
                    <button onclick="ajouterActe()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-lg cursor-pointer">➕ Ajouter</button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="bg-slate-100 text-slate-600 border-b">
                            <th class="p-2.5 w-32">Date (modifiable)</th>
                            <th class="p-2.5">Description précise de l'engagement (modifiable)</th>
                            <th class="p-2.5 w-44">Associé (modifiable)</th>
                            <th class="p-2.5 w-32">Montant TTC (€)</th>
                            <th class="p-2.5 text-right w-16">Action</th>
                        </tr>
                    </thead>
                    <tbody id="liste-actes" class="divide-y divide-slate-100"></tbody>
                </table>
            </div>
        </section>

        <!-- ONGLET 3 : CRM & PROSPECTION -->
        <section id="tab-crm" class="tab-content hidden bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4 no-print">
            <div class="flex flex-wrap justify-between items-center gap-2">
                <div>
                    <h3 class="text-base font-bold text-slate-800">🎯 CRM & Suivi Terrain Partagé</h3>
                    <p class="text-xs text-slate-500">Chaque ligne du CRM est modifiable directement. Passer un commerce en « ✅ Vendu & Encaissé » met à jour le Business Plan et l'Acte SAS.</p>
                </div>
                <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2 rounded-lg cursor-pointer shadow">
                    🖨️ Imprimer le Bilan Complet SAS
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-6 gap-2 text-xs">
                <input type="text" id="crm-nom" placeholder="Nom du commerce..." class="border border-slate-200 rounded-lg p-2">
                <input type="text" id="crm-ville" placeholder="Ville / Téléphone..." class="border border-slate-200 rounded-lg p-2">
                <select id="crm-qui" class="border border-slate-200 rounded-lg p-2"></select>
                <select id="crm-pack" class="border border-slate-200 rounded-lg p-2">
                    <option value="Pack Starter (49€)">Pack Starter</option>
                    <option value="Carte Solo (25€)">Carte Solo</option>
                    <option value="Pack CHR (139€)">Pack CHR</option>
                </select>
                <select id="crm-statut" class="border border-slate-200 rounded-lg p-2">
                    <option value="À visiter">⏳ À visiter</option>
                    <option value="Relance">🔥 À relancer</option>
                    <option value="Vendu">✅ Vendu & Encaissé</option>
                    <option value="Refus">❌ Refus</option>
                </select>
                <button onclick="ajouterProspect()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-4 py-2 rounded-lg cursor-pointer">➕ Ajouter</button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="bg-slate-100 text-slate-600 border-b">
                            <th class="p-2.5 w-28">Date</th>
                            <th class="p-2.5">Commerce</th>
                            <th class="p-2.5">Ville / Infos</th>
                            <th class="p-2.5 w-40">Commercial</th>
                            <th class="p-2.5 w-40">Offre</th>
                            <th class="p-2.5 w-44">Statut</th>
                            <th class="p-2.5 text-right w-14">Action</th>
                        </tr>
                    </thead>
                    <tbody id="liste-crm" class="divide-y divide-slate-100"></tbody>
                </table>
            </div>
        </section>

        <!-- DOCUMENT OFFICIEL PERMANENT (AFFICHÉ SOUS JOURNAL & CRM UNIQUEMENT + ENTIÈREMENT MODIFIABLE) -->
        <section id="wrapper-doc-officiel" class="hidden bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-5">
            <!-- PANNEAU DE PERSONNALISATION COMPLÈTE AVANT IMPRESSION (NON IMPRIMÉ) -->
            <div class="bg-slate-900 text-white p-5 rounded-xl space-y-4 text-xs no-print">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-700 pb-3">
                    <div class="flex items-center space-x-2">
                        <span class="bg-amber-500 text-slate-950 font-black px-2 py-0.5 rounded">ÉDITION COMPLÈTE</span>
                        <span class="font-bold">Personnalisation des Identités & Mentions Légales (Synchronisé Cloud) :</span>
                    </div>
                    <span class="text-[11px] text-slate-400 italic">💡 Astuce : vous pouvez aussi cliquer directement sur n'importe quel texte de l'aperçu blanc ci-dessous pour le retoucher.</span>
                </div>

                <!-- Ligne 1 : Prénoms et Noms complets des 3 associés -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="text-[10px] text-amber-400 font-bold uppercase block mb-1">Associé Fondateur 1 (Prénom & Nom)</label>
                        <input type="text" id="cfg-associe-1" value="Nathan RAGUENEAU" oninput="majParametresDoc()" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-bold">
                    </div>
                    <div>
                        <label class="text-[10px] text-amber-400 font-bold uppercase block mb-1">Associé Fondateur 2 (Prénom & Nom)</label>
                        <input type="text" id="cfg-associe-2" value="Charly (Nom à compléter)" oninput="majParametresDoc()" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-bold">
                    </div>
                    <div>
                        <label class="text-[10px] text-amber-400 font-bold uppercase block mb-1">Associé Fondateur 3 (Prénom & Nom)</label>
                        <input type="text" id="cfg-associe-3" value="Etan (Nom à compléter)" oninput="majParametresDoc()" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-bold">
                    </div>
                </div>

                <!-- Ligne 2 : Infos SAS, EI Mandataire, Lieu & Date -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div>
                        <label class="text-[10px] text-slate-400 block mb-1">Nom de la SAS en formation</label>
                        <input type="text" id="cfg-nom-sas" value="CNE SOLUTIONS" oninput="majParametresDoc()" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-bold">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-400 block mb-1">Capital & Siège social de la SAS</label>
                        <input type="text" id="cfg-siege-sas" value="SAS en cours de constitution" oninput="majParametresDoc()" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-bold">
                    </div>
                    <div>
