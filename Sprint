        function synchroniserVolumesCRM() {
            let countSolo = 0;
            let countStarter = 0;
            let countChr = 0;

            (appState.crm || []).forEach(c => {
                if (c.statut === 'Vendu') {
                    if (c.pack && c.pack.includes('Solo')) countSolo++;
                    else if (c.pack && c.pack.includes('Starter')) countStarter++;
                    else if (c.pack && c.pack.includes('CHR')) countChr++;
                }
            });

            document.getElementById('crm-count-solo').innerText = countSolo;
            document.getElementById('crm-count-starter').innerText = countStarter;
            document.getElementById('crm-count-chr').innerText = countChr;

            appState.volSolo = countSolo;
            appState.volStarter = countStarter;
            appState.volChr = countChr;

            document.getElementById('vol-solo').value = countSolo;
            document.getElementById('vol-starter').value = countStarter;
            document.getElementById('vol-chr').value = countChr;
        }

        function calculerChiffres() {
            const vSolo = parseFloat(document.getElementById('vol-solo').value) || 0;
            const pSolo = parseFloat(document.getElementById('prix-solo').value) || 25;
            const cSolo = parseFloat(document.getElementById('cogs-solo').value) || 2.0;

            const vStarter = parseFloat(document.getElementById('vol-starter').value) || 0;
            const pStarter = parseFloat(document.getElementById('prix-starter').value) || 49;
            const cStarter = parseFloat(document.getElementById('cogs-starter').value) || 4.8;

            const vChr = parseFloat(document.getElementById('vol-chr').value) || 0;
            const pChr = parseFloat(document.getElementById('prix-chr').value) || 139;
            const cChr = parseFloat(document.getElementById('cogs-chr').value) || 12.2;

            const cible = parseFloat(document.getElementById('cfg-cible-sas').value) || 500;
            const tauxCh = parseFloat(document.getElementById('cfg-taux-charges').value) || 14.05;

            const caSolo = vSolo * pSolo;
            const caStarter = vStarter * pStarter;
            const caChr = vChr * pChr;
            const caTotal = caSolo + caStarter + caChr;

            const cogsTotal = (vSolo * cSolo) + (vStarter * cStarter) + (vChr * cChr);
            const chargesTotal = caTotal * (tauxCh / 100);
            const netTotal = Math.max(0, caTotal - cogsTotal - chargesTotal);

            document.getElementById('kpi-ca').innerText = Math.round(caTotal) + " €";
            document.getElementById('kpi-cogs').innerText = Math.round(cogsTotal) + " €";
            document.getElementById('kpi-charges').innerText = Math.round(chargesTotal) + " €";
            document.getElementById('kpi-net').innerText = Math.round(netTotal) + " €";

            const pct = Math.min(100, Math.round((netTotal / Math.max(1, cible)) * 100));
            document.getElementById('jauge-texte').innerText = Math.round(netTotal) + " € / " + cible + " €";
            document.getElementById('header-jauge').innerText = Math.round(netTotal) + " € / " + cible + " €";
            document.getElementById('jauge-barre').style.width = pct + "%";
            document.getElementById('jauge-statut').innerText = pct >= 100 ? "✅ OBJECTIF ATTEINT (100%)" : `⏳ EN COURS (${pct}%)`;

            document.getElementById('out-taux-charges').innerText = tauxCh.toFixed(2);
            document.getElementById('bilan-ca').innerText = caTotal.toFixed(2) + " €";
            document.getElementById('bilan-cogs').innerText = "- " + cogsTotal.toFixed(2) + " €";
            document.getElementById('bilan-charges').innerText = "- " + chargesTotal.toFixed(2) + " €";
            document.getElementById('bilan-net-sas').innerText = netTotal.toFixed(2) + " €";

            majGraphiques(caTotal, cogsTotal, chargesTotal, netTotal, caSolo, caStarter, caChr);
        }

        function majGraphiques(ca, cogs, charges, net, solo, starter, chr) {
            if (chartStructure) {
                chartStructure.data.datasets[0].data = [Math.round(ca), Math.round(cogs), Math.round(charges), Math.round(net)];
                chartStructure.update();
            }
            if (chartProduits) {
                chartProduits.data.datasets[0].data = [Math.round(solo), Math.round(starter), Math.round(chr)];
                chartProduits.update();
            }
        }

        function initGraphiques() {
            const ctx1 = document.getElementById('chart-structure').getContext('2d');
            chartStructure = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: ['CA Brut', 'Matériel', 'URSSAF/SumUp', 'Net SAS'],
                    datasets: [{
                        label: '€ Net',
                        data: [0, 0, 0, 0],
                        backgroundColor: ['#0f172a', '#e11d48', '#d97706', '#059669'],
                        borderRadius: 6
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });

            const ctx2 = document.getElementById('chart-produits').getContext('2d');
            chartProduits = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Solo', 'Starter', 'Pack CHR'],
                    datasets: [{
                        data: [0, 0, 0],
                        backgroundColor: ['#64748b', '#f59e0b', '#6366f1']
                    }]
                },
                options: { plugins: { legend: { position: 'bottom' } } }
            });
        }

        function majParametresDoc() {
            isTyping = true;
            appState.associe1 = document.getElementById('cfg-associe-1').value.trim() || "Associé 1";
            appState.associe2 = document.getElementById('cfg-associe-2').value.trim() || "Associé 2";
            appState.associe3 = document.getElementById('cfg-associe-3').value.trim() || "Associé 3";
            appState.nomSas = document.getElementById('cfg-nom-sas').value.trim() || "CNE SOLUTIONS";
            appState.siegeSas = document.getElementById('cfg-siege-sas').value.trim() || "SAS en cours de constitution";
            appState.villeDoc = document.getElementById('cfg-ville-doc').value.trim() || "Blois";
            appState.dateDoc = document.getElementById('date-edition-doc').value;
            appState.mandataireEi = document.getElementById('cfg-mandataire-ei').value.trim();
            appState.clauseLegale = document.getElementById('cfg-clause-legale').value.trim();

            appliquerParametresDocDansDOM();
            majListesDeroulantesAssocies();

            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => {
                isTyping = false;
                sauvegarderVersCloud();
            }, 600);
        }

        function appliquerParametresDocDansDOM() {
            document.getElementById('out-associe-1').innerText = appState.associe1;
            document.getElementById('out-associe-2').innerText = appState.associe2;
            document.getElementById('out-associe-3').innerText = appState.associe3;
            document.getElementById('sig-associe-1').innerText = appState.associe1;
            document.getElementById('sig-associe-2').innerText = appState.associe2;
            document.getElementById('sig-associe-3').innerText = appState.associe3;

            document.getElementById('out-nom-sas').innerText = appState.nomSas;
            document.getElementById('out-nom-sas-2').innerText = appState.nomSas;
            document.getElementById('out-siege-sas').innerText = appState.siegeSas;
            document.getElementById('out-ville-doc').innerText = appState.villeDoc;
            document.getElementById('out-mandataire-ei').innerText = appState.mandataireEi;
            document.getElementById('out-clause-legale').innerText = appState.clauseLegale;

            const dateJourEl = document.getElementById('doc-date-jour');
            if (appState.dateDoc) {
                const d = new Date(appState.dateDoc);
                dateJourEl.innerText = d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
            } else {
                dateJourEl.innerText = new Date().toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
            }
        }

        function modifierLigneActe(index, champ, valeur) {
            if (!appState.actes[index]) return;
            appState.actes[index][champ] = champ === 'montant' ? (parseFloat(valeur) || 0) : valeur;
            afficherTableaux();
            sauvegarderVersCloud();
        }

        function modifierLigneCrm(index, champ, valeur) {
            if (!appState.crm[index]) return;
            appState.crm[index][champ] = valeur;
            synchroniserVolumesCRM();
            calculerChiffres();
            afficherTableaux();
            sauvegarderVersCloud();
        }

        function afficherTableaux() {
            const tbodyActes = document.getElementById('liste-actes');
            const docTbodyActes = document.getElementById('document-liste-actes');
            let totalActes = 0;

            const htmlActes = (appState.actes || []).map((a, i) => {
                totalActes += parseFloat(a.montant) || 0;
                return `
                    <tr>
                        <td class="p-1.5"><input type="text" value="${a.date || ''}" onchange="modifierLigneActe(${i}, 'date', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs"></td>
                        <td class="p-1.5"><input type="text" value="${a.desc || ''}" onchange="modifierLigneActe(${i}, 'desc', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs font-semibold"></td>
                        <td class="p-1.5"><input type="text" value="${a.auteur || ''}" onchange="modifierLigneActe(${i}, 'auteur', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs"></td>
                        <td class="p-1.5"><input type="number" step="0.01" value="${parseFloat(a.montant || 0)}" onchange="modifierLigneActe(${i}, 'montant', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs font-bold"></td>
                        <td class="p-1.5 text-right no-print"><button onclick="supprimerActe(${i})" class="text-rose-600 font-bold px-2 py-1 cursor-pointer">✕</button></td>
                    </tr>
                `;
            }).join('');

            const htmlDocActes = (appState.actes || []).length > 0 ? (appState.actes || []).map(a => `
                <tr>
                    <td contenteditable="true" class="p-2 border-r border-slate-300">${a.date || '-'}</td>
                    <td contenteditable="true" class="p-2 border-r border-slate-300">${a.desc}</td>
                    <td contenteditable="true" class="p-2 border-r border-slate-300">${a.auteur}</td>
                    <td contenteditable="true" class="p-2 text-right font-semibold">${parseFloat(a.montant || 0).toFixed(2)} €</td>
                </tr>
            `).join('') : `<tr><td colspan="4" class="p-3 text-center text-slate-400 italic">Aucune dépense enregistrée dans le journal.</td></tr>`;

            if (tbodyActes) tbodyActes.innerHTML = htmlActes;
            if (docTbodyActes) docTbodyActes.innerHTML = htmlDocActes;

            document.getElementById('document-total-actes').innerText = totalActes.toFixed(2) + " €";

            const tbodyCrm = document.getElementById('liste-crm');
            const docTbodyVentes = document.getElementById('document-liste-ventes');
            let totalVentesCrm = 0;

            if (tbodyCrm) {
                tbodyCrm.innerHTML = (appState.crm || []).map((c, i) => `
                    <tr>
                        <td class="p-1.5"><input type="text" value="${c.date || ''}" onchange="modifierLigneCrm(${i}, 'date', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs text-slate-600"></td>
                        <td class="p-1.5"><input type="text" value="${c.nom || ''}" onchange="modifierLigneCrm(${i}, 'nom', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs font-bold text-slate-900"></td>
                        <td class="p-1.5"><input type="text" value="${c.ville || ''}" onchange="modifierLigneCrm(${i}, 'ville', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs text-slate-600"></td>
                        <td class="p-1.5"><input type="text" value="${c.qui || ''}" onchange="modifierLigneCrm(${i}, 'qui', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs font-semibold"></td>
                        <td class="p-1.5">
                            <select onchange="modifierLigneCrm(${i}, 'pack', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs">
                                <option value="Pack Starter (49€)" ${c.pack && c.pack.includes('Starter') ? 'selected' : ''}>Pack Starter</option>
                                <option value="Carte Solo (25€)" ${c.pack && c.pack.includes('Solo') ? 'selected' : ''}>Carte Solo</option>
                                <option value="Pack CHR (139€)" ${c.pack && c.pack.includes('CHR') ? 'selected' : ''}>Pack CHR</option>
                            </select>
                        </td>
                        <td class="p-1.5">
                            <select onchange="modifierLigneCrm(${i}, 'statut', this.value)" class="w-full border border-slate-200 rounded p-1 text-xs font-bold">
                                <option value="À visiter" ${c.statut === 'À visiter' ? 'selected' : ''}>⏳ À visiter</option>
                                <option value="Relance" ${c.statut === 'Relance' ? 'selected' : ''}>🔥 À relancer</option>
                                <option value="Vendu" ${c.statut === 'Vendu' ? 'selected' : ''}>✅ Vendu & Encaissé</option>
                                <option value="Refus" ${c.statut === 'Refus' ? 'selected' : ''}>❌ Refus</option>
                            </select>
                        </td>
                        <td class="p-1.5 text-right"><button onclick="supprimerProspect(${i})" class="text-rose-600 font-bold px-2 py-1 cursor-pointer">✕</button></td>
                    </tr>
                `).join('');
            }

            const ventesValidees = (appState.crm || []).filter(c => c.statut === 'Vendu');
            const htmlDocVentes = ventesValidees.length > 0 ? ventesValidees.map(v => {
                let prix = 49;
                if (v.pack && v.pack.includes('Solo')) prix = parseFloat(appState.prixSolo) || 25;
                else if (v.pack && v.pack.includes('Starter')) prix = parseFloat(appState.prixStarter) || 49;
                else if (v.pack && v.pack.includes('CHR')) prix = parseFloat(appState.prixChr) || 139;
                totalVentesCrm += prix;
                return `
                    <tr>
                        <td contenteditable="true" class="p-2 border-r border-slate-300">${v.date || '-'}</td>
                        <td contenteditable="true" class="p-2 border-r border-slate-300 font-semibold">${v.nom}</td>
                        <td contenteditable="true" class="p-2 border-r border-slate-300">${v.ville || '-'}</td>
                        <td contenteditable="true" class="p-2 border-r border-slate-300">${v.qui}</td>
                        <td contenteditable="true" class="p-2 border-r border-slate-300">${v.pack}</td>
                        <td contenteditable="true" class="p-2 text-right font-semibold">${prix.toFixed(2)} €</td>
                    </tr>
                `;
            }).join('') : `<tr><td colspan="6" class="p-3 text-center text-slate-400 italic">Aucune vente passée au statut « Vendu » dans le CRM.</td></tr>`;

            if (docTbodyVentes) docTbodyVentes.innerHTML = htmlDocVentes;
            document.getElementById('document-total-ventes').innerText = totalVentesCrm.toFixed(2) + " €";
        }

        function ajouterActe() {
            const date = document.getElementById('acte-date').value || new Date().toLocaleDateString('fr-FR');
            const desc = document.getElementById('acte-desc').value.trim();
            const auteur = document.getElementById('acte-auteur').value;
            const montant = parseFloat(document.getElementById('acte-montant').value) || 0;
            if (!desc) return;
            appState.actes.push({ date, desc, auteur, montant });
            document.getElementById('acte-desc').value = '';
            document.getElementById('acte-montant').value = '';
            afficherTableaux();
            sauvegarderVersCloud();
        }

        function supprimerActe(index) {
            appState.actes.splice(index, 1);
            afficherTableaux();
            sauvegarderVersCloud();
        }

        function ajouterProspect() {
            const nom = document.getElementById('crm-nom').value.trim();
            const ville = document.getElementById('crm-ville').value.trim();
            const qui = document.getElementById('crm-qui').value;
            const pack = document.getElementById('crm-pack').value;
            const statut = document.getElementById('crm-statut').value;
            const date = new Date().toLocaleDateString('fr-FR');
            if (!nom) return;
            appState.crm.push({ date, nom, ville, qui, pack, statut });
            document.getElementById('crm-nom').value = '';
            document.getElementById('crm-ville').value = '';
            synchroniserVolumesCRM();
            calculerChiffres();
            afficherTableaux();
            sauvegarderVersCloud();
        }

        function supprimerProspect(index) {
            appState.crm.splice(index, 1);
            synchroniserVolumesCRM();
            calculerChiffres();
            afficherTableaux();
            sauvegarderVersCloud();
        }

        function calculerROI() {
            const tarif = parseFloat(document.getElementById('roi-tarif').value) || 49;
            const clientsJour = parseFloat(document.getElementById('roi-clients-jour').value) || 50;
            const taux = parseFloat(document.getElementById('roi-taux').value) || 5;
            const valeurClient = parseFloat(document.getElementById('roi-valeur-client').value) || 30;

            const avisMois = Math.round(clientsJour * 30 * (taux / 100));
            const avisAn = avisMois * 12;
            const sansDispositifAn = Math.max(2, Math.round(clientsJour * 30 * 0.002 * 12));
            const coutParAvis = avisAn > 0 ? (tarif / avisAn).toFixed(2) : tarif.toFixed(2);
            const caAnnuel = Math.round(avisAn * 0.15 * valeurClient);
            const nbClientsAmorti = Math.max(1, Math.ceil(tarif / valeurClient));
            const joursAmortissement = avisMois > 0 ? Math.max(1, Math.round(tarif / ((avisMois / 30) * (valeurClient * 0.2)))) : 15;
            const texteJours = joursAmortissement + (joursAmortissement > 1 ? " jours" : " jour");

            document.getElementById('roi-avis-mois').innerText = avisMois;
            document.getElementById('roi-avis-an').innerText = avisAn;
            document.getElementById('roi-cout-avis').innerText = coutParAvis + " €";
            document.getElementById('roi-ca-annuel').innerText = "+ " + caAnnuel.toLocaleString('fr-FR') + " €";
            document.getElementById('roi-nb-clients-amorti').innerText = nbClientsAmorti;
            document.getElementById('roi-temps-amortissement').innerText = texteJours;

            document.getElementById('comp-sans-avis').innerText = "~ " + sansDispositifAn + " avis / an";
            document.getElementById('comp-avec-avis').innerText = "+ " + avisAn + " avis / an";
            document.getElementById('comp-jours').innerText = texteJours;
        }

        function recalculerEtSauvegarder(manuel = false) {
            isTyping = true;
            if (manuel) {
                appState.volSolo = parseFloat(document.getElementById('vol-solo').value) || 0;
                appState.volStarter = parseFloat(document.getElementById('vol-starter').value) || 0;
                appState.volChr = parseFloat(document.getElementById('vol-chr').value) || 0;
            }
            appState.prixSolo = parseFloat(document.getElementById('prix-solo').value) || 25;
            appState.cogsSolo = parseFloat(document.getElementById('cogs-solo').value) || 2.0;
            appState.prixStarter = parseFloat(document.getElementById('prix-starter').value) || 49;
            appState.cogsStarter = parseFloat(document.getElementById('cogs-starter').value) || 4.8;
            appState.prixChr = parseFloat(document.getElementById('prix-chr').value) || 139;
            appState.cogsChr = parseFloat(document.getElementById('cogs-chr').value) || 12.2;
            appState.cibleSas = parseFloat(document.getElementById('cfg-cible-sas').value) || 500;
            appState.tauxCharges = parseFloat(document.getElementById('cfg-taux-charges').value) || 14.05;

            calculerChiffres();
            afficherTableaux();

            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => {
                isTyping = false;
                sauvegarderVersCloud();
            }, 500);
        }

        async function sauvegarderVersCloud() {
            appState.updatedAt = Date.now();
            localStorage.setItem('cne_sprint_state', JSON.stringify(appState));
            majBadgeSync('Synchronisation...', 'amber');
            try {
                await fetch(NPOINT_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(appState)
                });
                majBadgeSync('Cloud Sync Actif', 'emerald');
            } catch (e) {
                console.error('Erreur Sync Cloud:', e);
            }
        }

        async function chargerDepuisCloud(force = false) {
            if (isTyping && !force) return;
            try {
                const res = await fetch(NPOINT_URL, { cache: 'no-store' });
                const remote = await res.json();
                if (remote && remote.updatedAt && (force || remote.updatedAt > appState.updatedAt)) {
                    appState = Object.assign(appState, remote);
                    localStorage.setItem('cne_sprint_state', JSON.stringify(appState));
                    appliquerEtatDansDOM();
                } else if (remote && Object.keys(remote).length === 0 && appState.updatedAt === 0) {
                    await sauvegarderVersCloud();
                }
            } catch (e) {
                console.error('Erreur lecture Cloud:', e);
            }
        }

        function appliquerEtatDansDOM() {
            document.getElementById('prix-solo').value = appState.prixSolo ?? 25;
            document.getElementById('cogs-solo').value = appState.cogsSolo ?? 2.0;
            document.getElementById('prix-starter').value = appState.prixStarter ?? 49;
            document.getElementById('cogs-starter').value = appState.cogsStarter ?? 4.8;
            document.getElementById('prix-chr').value = appState.prixChr ?? 139;
            document.getElementById('cogs-chr').value = appState.cogsChr ?? 12.2;
            document.getElementById('cfg-cible-sas').value = appState.cibleSas ?? 500;
            document.getElementById('cfg-taux-charges').value = appState.tauxCharges ?? 14.05;

            document.getElementById('cfg-associe-1').value = appState.associe1 || "Nathan RAGUENEAU";
            document.getElementById('cfg-associe-2').value = appState.associe2 || "Charly (Nom à compléter)";
            document.getElementById('cfg-associe-3').value = appState.associe3 || "Etan (Nom à compléter)";
            document.getElementById('cfg-nom-sas').value = appState.nomSas || "CNE SOLUTIONS";
            document.getElementById('cfg-siege-sas').value = appState.siegeSas || "SAS en cours de constitution";
            document.getElementById('cfg-ville-doc').value = appState.villeDoc || "Blois";
            document.getElementById('cfg-mandataire-ei').value = appState.mandataireEi || "";
            document.getElementById('cfg-clause-legale').value = appState.clauseLegale || "";
            if (appState.dateDoc) {
                document.getElementById('date-edition-doc').value = appState.dateDoc;
            }

            appliquerParametresDocDansDOM();
            majListesDeroulantesAssocies();

            const nbVendusCrm = (appState.crm || []).filter(c => c.statut === 'Vendu').length;
            if (nbVendusCrm > 0) {
                synchroniserVolumesCRM();
            } else {
                document.getElementById('vol-solo').value = appState.volSolo ?? 0;
                document.getElementById('vol-starter').value = appState.volStarter ?? 0;
                document.getElementById('vol-chr').value = appState.volChr ?? 0;
            }

            calculerChiffres();
            afficherTableaux();
            calculerROI();
        }

        window.addEventListener('DOMContentLoaded', async () => {
            const todayIso = new Date().toISOString().split('T')[0];
            document.getElementById('date-edition-doc').value = todayIso;
            document.getElementById('acte-date').value = todayIso;

            initGraphiques();
            const local = localStorage.getItem('cne_sprint_state');
            if (local) {
                try { appState = Object.assign(appState, JSON.parse(local)); } catch(e) {}
            }
            appliquerEtatDansDOM();
            await chargerDepuisCloud(true);
            setInterval(() => chargerDepuisCloud(false), 5000);
        });
    </script>
</body>
